# DSir Backend Environment Configuration
# Copy this file to .env and fill in your values

# Application
APP_NAME=DSir API
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Database
# Optional: set DATABASE_READ_REPLICA_URL to enable read replicas
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/dsir
DATABASE_READ_REPLICA_URL=
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE=3600
# Slow query logging threshold in seconds
DATABASE_SLOW_QUERY_THRESHOLD=1.0

# Redis
# Optional: set REDIS_PASSWORD for Redis instances with auth (e.g. Render/Railway)
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# JWT
JWT_SECRET_KEY=generate-a-strong-random-secret-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ================================================================
# AI PROVIDERS — Choose one. All work with the existing code.
# ================================================================

# --- Option 1: Gemini (Google AI) — FREE tier ---
# Get key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
AI_DEFAULT_PROVIDER=gemini
AI_DEFAULT_MODEL=gemini-2.0-flash

# --- Option 2: Groq — FREE tier, fastest inference ---
# Get key: https://console.groq.com/keys
# Check models: https://console.groq.com/docs/models
# Uncomment below and comment out Gemini:
# OPENAI_API_KEY=gsk_your-groq-key-here
# AI_DEFAULT_PROVIDER=openai
# AI_DEFAULT_MODEL=llama-3.3-70b-versatile
# AI_OPENAI_BASE_URL=https://api.groq.com/openai/v1

# --- Option 3: NVIDIA Nemotron 3 Ultra 550B — 1M context, frontier reasoning ---
# Get key: https://build.nvidia.com/explore/discover
# 550B params (55B active), Mamba-2 + MoE hybrid, 1M token context
# Uncomment below and comment out Gemini:
# OPENAI_API_KEY=nvapi-your-nvidia-key-here
# AI_DEFAULT_PROVIDER=nvidia
# AI_DEFAULT_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# AI_OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1

# --- Option 4: DeepSeek — cheap, great for code ---
# Get key: https://platform.deepseek.com/api_keys
# Uncomment below and comment out Gemini:
# OPENAI_API_KEY=sk-your-deepseek-key-here
# AI_DEFAULT_PROVIDER=openai
# AI_DEFAULT_MODEL=deepseek-chat
# AI_OPENAI_BASE_URL=https://api.deepseek.com/v1

# --- Option 5: OpenRouter — access to 300+ models ---
# Get key: https://openrouter.ai/keys
# Uncomment below and comment out Gemini:
# OPENAI_API_KEY=sk-or-v1-your-key-here
# AI_DEFAULT_PROVIDER=openai
# AI_DEFAULT_MODEL=google/gemini-2.0-flash-001
# AI_OPENAI_BASE_URL=https://openrouter.ai/api/v1

# --- Option 6: Cloudflare Workers AI — FREE tier, OpenAI-compatible ---
# Get an API token: https://dash.cloudflare.com/profile/api-tokens
# Find your Account ID on the Workers & Pages dashboard home.
# Models use the @cf/ prefix, e.g. @cf/meta/llama-3.1-8b-instruct
# Full model list: https://developers.cloudflare.com/workers-ai/models/
# Uncomment below and comment out Gemini:
# OPENAI_API_KEY=your-cloudflare-api-token-here
# AI_DEFAULT_PROVIDER=openai
# AI_DEFAULT_MODEL=@cf/meta/llama-3.1-8b-instruct
# AI_OPENAI_BASE_URL=https://api.cloudflare.com/client/v4/accounts/YOUR_ACCOUNT_ID/ai/v1

# --- Anthropic Claude (optional fallback provider) ---
# Get key: https://console.anthropic.com/
# ANTHROPIC_API_KEY=
# AI_DEFAULT_PROVIDER=anthropic
# AI_DEFAULT_MODEL=claude-3-5-sonnet-20241022

# Storage
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./uploads
# Optional: set S3_BUCKET for S3-compatible storage
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Code Sandbox
SANDBOX_DOCKER_IMAGE=dsir-sandbox:latest
SANDBOX_MAX_EXECUTION_TIME=30
SANDBOX_MAX_MEMORY_MB=256
SANDBOX_MAX_CONCURRENT=10

# CORS
CORS_ORIGINS=["http://localhost:3000","https://dsir.vercel.app","https://dsir.dshost.dpdns.org","https://api.dshost.dpdns.org"]

# Rate Limiting
RATE_LIMIT_GLOBAL=100
RATE_LIMIT_GLOBAL_WINDOW=60
RATE_LIMIT_AUTH=10
RATE_LIMIT_AUTH_WINDOW=60

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Email
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@dsir.dev

# Feature Flags
ENABLE_AI_FEATURES=true
ENABLE_SANDBOX=true
ENABLE_REGISTRATION=true
# Chaos Engineering (admin chaos endpoints)
CHAOS_ENABLED=false
