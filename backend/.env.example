# DSir Backend Environment Configuration
# Copy this file to .env and fill in your values

# Application
APP_NAME=DSir API
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/dsir
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=generate-a-strong-random-secret-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# AI Providers (required for AI features)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_DEFAULT_PROVIDER=openai
AI_DEFAULT_MODEL=gpt-4o-mini

# Storage
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./uploads

# CORS
CORS_ORIGINS=["http://localhost:3000","https://dsir.vercel.app"]

# Rate Limiting
RATE_LIMIT_GLOBAL=100
RATE_LIMIT_GLOBAL_WINDOW=60

# Feature Flags
ENABLE_AI_FEATURES=true
ENABLE_SANDBOX=true
ENABLE_REGISTRATION=true
