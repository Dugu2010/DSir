# DSir Backend Environment Configuration
# Copy this file to .env and fill in your values

# Application
APP_NAME=DSir API
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/dsir
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=generate-a-strong-random-secret-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ═══════════════════════════════════════════════════════════════
# AI PROVIDERS — Choose one:
# ═══════════════════════════════════════════════════════════════

# ── Option 1: Gemini (Google AI) — FREE tier ──
# Get key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
AI_DEFAULT_PROVIDER=gemini
AI_DEFAULT_MODEL=gemini-2.0-flash

# ── Option 2: Groq — FREE tier, blazing fast ──
# Get key: https://console.groq.com/keys
# Check current models: https://console.groq.com/docs/models
# Uncomment below and comment out Gemini:
# OPENAI_API_KEY=gsk_your-groq-key-here
# AI_DEFAULT_PROVIDER=openai
# AI_DEFAULT_MODEL=llama-3.3-70b-versatile
# AI_OPENAI_BASE_URL=https://api.groq.com/openai/v1

# ── Option 3: DeepSeek — cheap/free, great for code ──
# Get key: https://platform.deepseek.com/api_keys
# Uncomment below and comment out Gemini:
# OPENAI_API_KEY=sk-your-deepseek-key-here
# AI_DEFAULT_PROVIDER=openai
# AI_DEFAULT_MODEL=deepseek-chat
# AI_OPENAI_BASE_URL=https://api.deepseek.com/v1

# ── Option 4: OpenRouter — free models available ──
# Get key: https://openrouter.ai/keys
# Uncomment below and comment out Gemini:
# OPENAI_API_KEY=sk-or-v1-your-key-here
# AI_DEFAULT_PROVIDER=openai
# AI_DEFAULT_MODEL=google/gemini-2.0-flash-001
# AI_OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Storage
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./uploads

# CORS
CORS_ORIGINS=["http://localhost:3000","https://dsir.vercel.app"]

# Rate Limiting
RATE_LIMIT_GLOBAL=100
RATE_LIMIT_GLOBAL_WINDOW=60

# Feature Flags
ENABLE_AI_FEATURES=true
ENABLE_SANDBOX=true
ENABLE_REGISTRATION=true
